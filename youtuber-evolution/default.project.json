{
  "name": "YoutuberEvolution",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CharacterWalkSpeed": 20,
        "CharacterJumpPower": 50,
        "CameraMaxZoomDistance": 90,
        "CameraMinZoomDistance": 6
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": false,
        "FallenPartsDestroyHeight": -300
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "ShadowMap",
        "Ambient": [0.33, 0.33, 0.4],
        "OutdoorAmbient": [0.6, 0.6, 0.66],
        "Brightness": 3,
        "ClockTime": 14.2,
        "GeographicLatitude": 25,
        "EnvironmentDiffuseScale": 1,
        "EnvironmentSpecularScale": 0.6,
        "ExposureCompensation": 0.1,
        "ShadowSoftness": 0.25,
        "GlobalShadows": true
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.28,
          "Offset": 0.12,
          "Color": [0.78, 0.86, 1],
          "Decay": [0.45, 0.5, 0.6],
          "Glare": 0.15,
          "Haze": 1.1
        }
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.55,
          "Size": 24,
          "Threshold": 1.7
        }
      },
      "ColorCorrection": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Saturation": 0.16,
          "Contrast": 0.06,
          "Brightness": 0.02
        }
      },
      "SunRays": {
        "$className": "SunRaysEffect",
        "$properties": {
          "Intensity": 0.05,
          "Spread": 0.6
        }
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
