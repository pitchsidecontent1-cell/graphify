	Saturation: number,
	Tint: Color3,
	BloomIntensity: number,
}

export type Rival = {
	Name: string,
	Title: string,
	Emoji: string,
	Video: number, -- you need this Video level worth of views to be "even" with them
	SkinColor: Color3,
	ShirtColor: Color3,
	PantsColor: Color3,
	Taunts: { string },
	Duration: number,
	Surges: number,
	FirstWinTickets: number,
	FirstWinPads: number, -- reward = this many claims of the world's last pad
	ReplayPads: number,
	Cooldown: number,
	Boss: boolean?,
}

export type World = {
	Id: number,
	Name: string,
	Tagline: string,
	DeviceKind: string,
	DeviceLabel: string,
	Origin: Vector3,
	Palette: Palette,
	Lighting: LightingPreset,
	Gates: { number },
	Rival: Rival,
	Eggs: { string },
	Decor: string,
}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

